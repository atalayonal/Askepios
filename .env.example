# Supabase projesi > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Sadece sunucuda kullanılır (kullanıcı daveti gibi admin işlemleri). Asla NEXT_PUBLIC_ ile başlatmayın.
SUPABASE_SERVICE_ROLE_KEY=
# Kliniklerin "Askepios ile iletişime geç" butonunda görünür.
ASKEPIOS_CONTACT_EMAIL=
# Ülke koduyla, sadece rakam: 905xxxxxxxxx
ASKEPIOS_CONTACT_WHATSAPP=
# E-posta bildirimleri (Resend). Boş bırakılırsa e-posta gönderilmez.
RESEND_API_KEY=
EMAIL_FROM=Askepios <bildirim@askepios.com>
# Yeni talep bildirimlerinin gideceği adresler, virgülle ayrılmış.
ADMIN_NOTIFY_EMAILS=
# E-postalardaki bağlantılar için sitenin adresi.
APP_URL=https://booking.askepios.com
